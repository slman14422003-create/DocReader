<?xml version="1.0" encoding="utf-8"?>
<!-- قارئ PDF (تصميم جديد): الصفحات تملأ الشاشة كاملة، والشريط العلوي (العنوان + التكبير + المزيد +
     شريط البحث) وشريط التنقل السفلي (مؤشر سحب للصفحات) يطفوان فوقها ويختفيان بلمسة واحدة على
     الصفحة (وضع القراءة الهادئ) دون أن يقفز المحتوى. لمستان على الصفحة = تكبير/إرجاع. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <HorizontalScrollView
            android:id="@+id/pdf_hscroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pdf_pages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="72dp"
                android:paddingBottom="92dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/pdf_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/primary_cyan" />

            <TextView
                android:id="@+id/pdf_loading_text"
                style="@style/Phizyo.Body.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="جارٍ التحميل..." />
        </LinearLayout>

        <include
            android:id="@+id/pdf_empty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- مشغّل القراءة الصوتية: بطاقة عائمة تظهر فقط أثناء القراءة. في أعلاها حالة القراءة
             (الصفحة)، ثم فقاعة بداخلها موجة تتحرك بحسب الصوت الفعلي (VoiceWaveView)،
             ثم أزرار التحكم (إيقاف، صفحة سابقة/تالية، تشغيل/إيقاف مؤقت، سرعة، إعدادات الصوت). -->
        <LinearLayout
            android:id="@+id/tts_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tts_player"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tts_status"
                style="@style/Phizyo.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <com.docreader.app.pdf.VoiceWaveView
                android:id="@+id/tts_wave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/tts_close"
                        style="@style/Phizyo.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="إيقاف القراءة"
                        android:src="@drawable/ic_close" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/tts_prev"
                        style="@style/Phizyo.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="الصفحة السابقة"
                        android:src="@drawable/ic_tts_prev" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.3">

                    <ImageButton
                        android:id="@+id/tts_play"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tts_play_button"
                        android:contentDescription="تشغيل / إيقاف مؤقت"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tts_pause"
                        android:tint="@color/white" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/tts_next"
                        style="@style/Phizyo.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="الصفحة التالية"
                        android:src="@drawable/ic_tts_next" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.2">

                    <TextView
                        android:id="@+id/tts_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tts_speed_chip"
                        android:clickable="true"
                        android:contentDescription="سرعة القراءة"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="52dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="1.0x"
                        android:textColor="@color/primary_cyan_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/tts_settings"
                        style="@style/Phizyo.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="إعدادات الصوت"
                        android:src="@drawable/ic_sliders" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/pdf_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_pill_inverse"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/surface_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- شريط التنقل السفلي: سحب سريع بين الصفحات + رقم الصفحة -->
        <LinearLayout
            android:id="@+id/pdf_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_tts_player"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/nav_seek"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="1"
                android:progressTint="@color/primary_cyan"
                android:thumbTint="@color/primary_cyan" />

            <TextView
                android:id="@+id/nav_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="58dp"
                android:gravity="end"
                android:textColor="@color/pdf_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- الشريط العلوي العائم: العنوان + شريط البحث (مخفي حتى الطلب) -->
    <LinearLayout
        android:id="@+id/top_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/bg_deep_1"
        android:elevation="4dp"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Phizyo.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:popupTheme="@style/ThemeOverlay.ClinicalMaster.PopupMenu">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pdf_title"
                    style="@style/Phizyo.HeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="190dp"
                    android:text="ملف PDF" />

                <TextView
                    android:id="@+id/pdf_subtitle"
                    style="@style/Phizyo.HeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <LinearLayout
            android:id="@+id/pdf_search_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/search_close"
                style="@style/Phizyo.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="إغلاق البحث"
                android:padding="9dp"
                android:src="@drawable/ic_close" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="ابحث داخل الملف..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="@color/pdf_text_primary"
                android:textColorHint="@color/pdf_text_tertiary"
                android:textDirection="rtl"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="52dp"
                android:gravity="center"
                android:textColor="@color/pdf_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/search_prev"
                style="@style/Phizyo.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="النتيجة السابقة"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_up" />

            <ImageButton
                android:id="@+id/search_next"
                style="@style/Phizyo.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="النتيجة التالية"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_border_soft" />
    </LinearLayout>
</FrameLayout>
