<?xml version="1.0" encoding="utf-8"?>
<!-- الشريط العلوي الموحّد لكل القارئات (Word / Excel / عارض المستندات / الإعدادات):
     نفس خلفية وارتفاع وخط عنوان قارئ PDF، العنوان في المنتصف وتحته سطر فرعي صغير، وخط فاصل رفيع. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_deep_1"
    android:elevation="2dp"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/pdf_text_primary"
        app:popupTheme="@style/ThemeOverlay.ClinicalMaster.PopupMenu"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="@style/Phizyo.TopBarSubtitle"
        app:titleCentered="true"
        app:titleTextAppearance="@style/Phizyo.TopBarTitle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/glass_border_soft" />
</LinearLayout>
