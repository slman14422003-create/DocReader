<?xml version="1.0" encoding="utf-8"?>
<!-- تلاشي خروج كامل (1 → 0) - يُستخدم لخروج شاشة splash نفسها، مختلف عن
     fade_out.xml الموجود (اللي بيروح لـ 0.3 بس، مصمم لسيناريو تاني). -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha
        android:duration="360"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
