<?xml version="1.0" encoding="utf-8"?>
<!-- حقل نص: يتميّز بإطار بلون العلامة عند التركيز (كان الحقل لا يعطي أي إشارة
     بصرية أثناء الكتابة). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/field_focus_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_soft" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
