<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة/زر قابل للضغط: نفس شكل bg_glass_card (ظل ناعم أسفلها) + ripple
     محصور داخل الزوايا المدوّرة (لا يتسرّب خارجها). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_highlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_shadow" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill_strong" />
                    <corners android:radius="20dp" />
                    <stroke android:width="1dp" android:color="@color/glass_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
