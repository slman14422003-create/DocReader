<?xml version="1.0" encoding="utf-8"?>
<!-- شريط تقدّم الرفع (Determinate): مسار رفيع بلون الحد + تعبئة بلون التطبيق، أطراف مستديرة.
     gravity=start عشان يتعبّى من اليمين في الواجهة العربية (RTL). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_border_soft" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <solid android:color="@color/primary_cyan" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
