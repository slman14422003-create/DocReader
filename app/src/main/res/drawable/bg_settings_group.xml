<?xml version="1.0" encoding="utf-8"?>
<!-- مجموعة صفوف (مثل إعدادات Claude): بطاقة مدوّرة بحدّ شعري رفيع يفصلها عن
     الخلفية الكريمية. لازم يُضاف معها clipToOutline=true عشان الـ ripple
     ما يطلع خارج الزوايا. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_fill_strong" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="@color/glass_border_soft" />
</shape>
