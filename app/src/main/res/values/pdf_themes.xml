<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ثيم قارئ PDF (فاتح). النسخة الداكنة في values-night/pdf_themes.xml -->
    <style name="Theme.DocReader.PdfReader" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_cyan</item>
        <item name="colorPrimaryVariant">@color/primary_cyan_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorSecondaryVariant">@color/accent_violet_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/pdf_text_primary</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="android:statusBarColor">@color/bg_deep_1</item>
        <item name="android:navigationBarColor">@color/bg_deep_1</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:textColorHint">@color/pdf_text_tertiary</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.M3.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.M3.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.M3.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.M3.Corner.Large</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ClinicalMaster.Dialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.ClinicalMaster.Activity</item>
        <item name="android:colorControlHighlight">@color/glass_highlight</item>
        <item name="colorControlHighlight">@color/glass_highlight</item>
        <item name="android:colorEdgeEffect" tools:targetApi="lollipop">@color/primary_cyan</item>
        <item name="android:textColorHighlight">@color/m3_primary_container</item>
        <item name="android:textColorLink">@color/primary_cyan_dark</item>
        <item name="android:textCursorDrawable" tools:targetApi="q">@drawable/cursor_brand</item>
    </style>

    <!-- زوايا Material 3 -->
    <style name="ShapeAppearance.M3.Corner.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.M3.Corner.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.M3.Corner.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.M3.Corner.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- انتقالات الأنشطة -->
    <style name="Animation.ClinicalMaster.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- الحوارات والقوائم المنبثقة -->
    <style name="ThemeOverlay.ClinicalMaster.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_card</item>
    </style>
    <style name="ThemeOverlay.ClinicalMaster.PopupMenu" parent="ThemeOverlay.Material3">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- ثيم حوار ClaudeDialog (الخلفية شفافة والبطاقة ترسمها dialog_claude.xml) -->
    <style name="ClaudeDialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- أنماط الواجهة -->
    <style name="Phizyo.IconButton" parent="">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/pdf_text_primary</item>
    </style>
    <style name="Phizyo.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/bg_top_bar_modern</item>
        <item name="titleTextColor">@color/pdf_text_primary</item>
    </style>
    <style name="Phizyo.HeaderTitle" parent="">
        <item name="android:textColor">@color/pdf_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Phizyo.HeaderSubtitle" parent="">
        <item name="android:textColor">@color/pdf_text_secondary</item>
        <item name="android:textSize">11.5sp</item>
    </style>
    <style name="Phizyo.HeroTitle" parent="">
        <item name="android:textColor">@color/pdf_text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Phizyo.Body.Secondary" parent="">
        <item name="android:textColor">@color/pdf_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Phizyo.Button.Primary" parent="">
        <item name="android:background">@drawable/bg_button_filled_pill</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- صفوف قائمة المزيد -->
    <style name="Settings.Row" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Settings.RowIcon" parent="">
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:tint">@color/pdf_text_secondary</item>
    </style>
    <style name="Settings.RowTitle" parent="">
        <item name="android:textColor">@color/pdf_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Settings.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/glass_border_soft</item>
    </style>
</resources>
